<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />


    <application
        android:name=".AdClass"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/playverse"
        android:label="@string/app_name"
        android:roundIcon="@drawable/playverse"
        android:supportsRtl="true"
        android:theme="@style/Theme.PlayVerse">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-8678839926764431~1604985733" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PlayVerse">
        </activity>

        <activity
            android:name=".games.TapGameActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PlayVerse">
        </activity>
        <activity
            android:name=".games.GuessTheNumGameActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PlayVerse">
        </activity>
        <activity
            android:name=".games.SnakeGameActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PlayVerse">
        </activity>
        <activity
            android:name=".games.AvoidTheBlocks"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PlayVerse">
        </activity>
        <activity
            android:name=".games.BrickBreaker"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PlayVerse">
        </activity>
        <activity
            android:name=".games.CatchTheObject"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PlayVerse">
        </activity>
        <activity
            android:name=".games.TicTacToeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PlayVerse">
        </activity>
        <activity
            android:name=".games.MemoryMatchActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PlayVerse">
        </activity>

        <activity
            android:name=".OnePlayerMain"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PlayVerse">
        </activity>
        <activity
            android:name=".TwoPlayerMain"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PlayVerse">
        </activity>
        <activity
            android:name=".info_screens.InfoScreen"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PlayVerse">
        </activity>
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PlayVerse">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>